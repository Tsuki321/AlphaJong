<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlphaJong" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/seed</item>
        <item name="colorOnPrimary">@color/on_background</item>
        <item name="android:statusBarColor">@color/seed_dark</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
    <style name="ThemeOverlay.AlphaJong.CompactToolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="actionButtonStyle">@style/Widget.AlphaJong.CompactActionButton</item>
        <item name="actionOverflowButtonStyle">@style/Widget.AlphaJong.CompactOverflowButton</item>
    </style>
    <style name="Widget.AlphaJong.CompactActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="Widget.AlphaJong.CompactOverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="TextAppearance.AlphaJong.CompactTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
